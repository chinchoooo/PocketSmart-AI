# Copy this file to `.env` and fill in the values. NEVER commit the real .env file.

# Gemini API key from https://aistudio.google.com/apikey  (leave blank to run in offline-fallback mode)
GOOGLE_API_KEY=

# Primary model. If it is retired/unavailable the app automatically tries newer/older fallbacks.
GEMINI_MODEL=gemini-3.8-flash

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Optional
# DATABASE_PATH=pocketsmart.db
# COOKIE_SECURE=true        # set to true when served over HTTPS
